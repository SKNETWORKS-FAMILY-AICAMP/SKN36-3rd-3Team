
# ============================================
# SKN36 노인복지 Hybrid RAG 환경변수 예시
# 실제 비밀번호와 API 키는 .env에만 입력
# ============================================

# OpenAI LLM
OPENAI_API_KEY=your_openai_api_key
CHAT_MODEL=gpt-4.1-mini

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=welfare_chunks_v1
QDRANT_API_KEY=

# Neo4j Graph DB
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Neo4j C안 정책 관계 확장
# 검수·승인된 관계를 적재한 뒤 true로 변경
ENABLE_REVIEWED_GRAPH_EXPANSION=false

# PostgreSQL 대화 기억
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=welfare_db
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/welfare_db

# 대화 기억 활성화
CHAT_MEMORY_ENABLED=false

# FastAPI
CHAT_API_MOCK=true
